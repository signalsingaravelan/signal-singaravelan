# Copy to .env and fill in real values. Never commit the real .env file.
#
# One Alpaca API key/secret pair per account defined in accounts.yaml,
# named after that account's api_key_env / api_secret_env.

ALPACA_API_KEY_TAXABLE_LETF=
ALPACA_API_SECRET_TAXABLE_LETF=

ALPACA_API_KEY_TAXABLE_IETF=
ALPACA_API_SECRET_TAXABLE_IETF=

ALPACA_API_KEY_ROTH_IRA_VC=
ALPACA_API_SECRET_ROTH_IRA_VC=

ALPACA_API_KEY_ROTH_IRA_MS=
ALPACA_API_SECRET_ROTH_IRA_MS=

# AWS credentials are picked up from the default boto3 credential chain
# (aws configure / IAM role) - not needed here unless you prefer env vars.
