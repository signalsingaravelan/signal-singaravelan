# Multi-account trading configuration.
#
# Each entry is one Alpaca brokerage account. Every account needs its own
# Alpaca API key/secret pair (Alpaca has no concept of sub-accounts under a
# single key). Put those values in AWS Secrets Manager secret
# SignalSingaravelanSecrets under the JSON keys named below (see README).
# Allocation percentages for an enabled account must sum to 100.
#
# performance_start_date is optional (ISO YYYY-MM-DD). When set, portfolio
# performance charts use that funding/start date; when omitted, the chart is skipped.
#
# Add, remove, or reconfigure accounts here without touching any code.

accounts:

  - name: paper-account-1
    enabled: false
    paper: false
    api_key_env: ALPACA_API_KEY_PAPER1
    api_secret_env: ALPACA_API_SECRET_PAPER1
    performance_start_date: "2026-08-24"
    allocations:
      TQQQ: 100

  - name: taxable-leveraged-etf
    enabled: false
    paper: false
    api_key_env: ALPACA_API_KEY_TAXABLE_LETF
    api_secret_env: ALPACA_API_SECRET_TAXABLE_LETF
    performance_start_date: "2026-08-24"
    allocations:
      TQQQ: 100

  - name: taxable-index-etf
    enabled: false
    paper: false
    api_key_env: ALPACA_API_KEY_TAXABLE_IETF
    api_secret_env: ALPACA_API_SECRET_TAXABLE_IETF
    performance_start_date: "1901-01-01"
    allocations:
      VTI: 20
      VOO: 20
      VUG: 30
      VGT: 15
      QQQ: 15

  - name: roth-ira-vc
    enabled: false
    paper: false
    api_key_env: ALPACA_API_KEY_ROTH_IRA_VC
    api_secret_env: ALPACA_API_SECRET_ROTH_IRA_VC
    performance_start_date: "2026-09-09"
    allocations:
      VTI: 20
      VOO: 20
      VUG: 30
      VGT: 15
      QQQ: 15

  - name: roth-ira-ms
    enabled: false
    paper: false
    api_key_env: ALPACA_API_KEY_ROTH_IRA_MS
    api_secret_env: ALPACA_API_SECRET_ROTH_IRA_MS
    performance_start_date: "1901-01-01"
    allocations:
      VTI: 20
      VOO: 20
      VUG: 30
      VGT: 15
      QQQ: 15
